{
  "name": "@atlas/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "dev:pglite": "DATABASE_URL=pglite://memory ADMIN_API_KEY=local-dev-key-local-dev-key-xx tsx watch src/main.ts"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/throttler": "^6.7.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.0",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7",
    "tsup": "^8"
  }
}
